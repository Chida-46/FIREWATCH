# NASA Earthdata FIRMS API Key (Obtain free at: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=your_firms_map_key_here

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Database Configuration (Optional PostGIS for enterprise deployment)
DATABASE_URL=postgresql://firewatch:firewatch_secret@localhost:5432/firewatch_db

# Spatial Harmonization Defaults
DEFAULT_GRID_SIZE_DEG=0.1
DEFAULT_COUNTRY=IND
